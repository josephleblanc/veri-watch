# Local Liquid inference: isolated Ollama, NOT the existing server on port 11434.
LIQUID_OLLAMA_URL=http://127.0.0.1:11435
LIQUID_MODEL=hf.co/LiquidAI/LFM2.5-1.2B-Instruct-GGUF:Q4_K_M
LIQUID_TIMEOUT_MS=120000

# Cloud operations remain unavailable until real credentials are supplied.
NIMBLE_API_KEY=
RAWTREE_API_KEY=

# Documented HTTP API base URLs (no trailing /v1 or /v2).
NIMBLE_BASE_URL=https://sdk.nimbleway.com
RAWTREE_BASE_URL=https://api.rawtree.com
# Optional: otherwise RawTree uses the API key's default database.
RAWTREE_DATABASE=

# Bounds also cover response-body reads. No automatic retries.
PROVIDER_TIMEOUT_MS=45000
PROVIDER_STATUS_TIMEOUT_MS=5000
